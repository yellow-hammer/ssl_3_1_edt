// Примеры НАМЕРЕННО падающих тестов YAxUnit - чтобы видеть красные статусы
// и сообщения об ошибках в панели тестирования.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("Упасть_НеверноеОжидание")
		.ДобавитьТест("Упасть_Исключение")
		.ДобавитьТест("Пройти_ДляКонтраста");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура Упасть_НеверноеОжидание() Экспорт

	ЮТест.ОжидаетЧто(2 + 2, "Намеренно неверное ожидание").Равно(5);

КонецПроцедуры

Процедура Упасть_Исключение() Экспорт

	ВызватьИсключение "Намеренное исключение для примера падения";

КонецПроцедуры

Процедура Пройти_ДляКонтраста() Экспорт

	ЮТест.ОжидаетЧто(1).Равно(1);

КонецПроцедуры

#КонецОбласти
