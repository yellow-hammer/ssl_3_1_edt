#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("СокращениеПробелов")
		.ДобавитьТест("ПреобразованиеРегистра")
		.ДобавитьТест("РазделениеСтроки");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура СокращениеПробелов() Экспорт

	ЮТест.ОжидаетЧто(СокрЛП("  строка  ")).Равно("строка");

КонецПроцедуры

Процедура ПреобразованиеРегистра() Экспорт

	ЮТест.ОжидаетЧто(ВРег("тест")).Равно("ТЕСТ");
	ЮТест.ОжидаетЧто(НРег("ТЕСТ")).Равно("тест");

КонецПроцедуры

Процедура РазделениеСтроки() Экспорт

	Части = СтрРазделить("а;б;в", ";");

	ЮТест.ОжидаетЧто(Части)
		.ИмеетДлину(3)
		.Содержит("а");

КонецПроцедуры

#КонецОбласти
