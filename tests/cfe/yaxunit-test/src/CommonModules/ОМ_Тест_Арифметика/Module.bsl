// Пример модульного теста YAxUnit (https://bia-technologies.github.io/yaxunit/).
//
// Модуль живёт в тестовом расширении «Тесты»; перед запуском расширение
// должно быть собрано и загружено в ИБ вместе с движком YAxUnit.
//
// Запуск из командной строки:
//   vrunner run --command RunUnitTests=tools/yaxunit.json --settings env.json
// или из панели тестирования VS Code (расширение 1C: Platform Tools).

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("СложениеЧисел")
		.ДобавитьТест("УмножениеЧисел")
		.ДобавитьТест("ОкруглениеЧисел")
		.ДобавитьТест("ДелениеЧисел", "Деление без остатка возвращает целое число", "Позитив");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура СложениеЧисел() Экспорт

	ЮТест.ОжидаетЧто(2 + 2)
		.ИмеетТип("Число")
		.Равно(4);

КонецПроцедуры

Процедура УмножениеЧисел() Экспорт

	ЮТест.ОжидаетЧто(3 * 7).Равно(21);

КонецПроцедуры

Процедура ОкруглениеЧисел() Экспорт

	ЮТест.ОжидаетЧто(Окр(2.44, 1)).Равно(2.4);

КонецПроцедуры

Процедура ДелениеЧисел() Экспорт

	ЮТест.ОжидаетЧто(10 / 2).Равно(5);

КонецПроцедуры

#КонецОбласти
